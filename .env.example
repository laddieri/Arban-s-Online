# Cloudflare R2 Bucket Configuration
# Copy this file to .env.local and update with your values

# Your Cloudflare R2 public bucket URL
# Example: https://pub-abc123def456.r2.dev
NEXT_PUBLIC_IMAGE_BASE_URL=https://your-bucket.r2.dev

# Total number of pages in your PDF (count the images you uploaded)
NEXT_PUBLIC_TOTAL_PAGES=350

# Image format (jpg, png, or webp)
NEXT_PUBLIC_IMAGE_FORMAT=jpg
